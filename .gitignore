# Machine-specific paths and credentials. Commit the example files only.
/.local/
/data/
/dataset/
/datasets/
machine.local.json
config.local.*
*.local.json
*.local.yaml
*.local.yml
.env*
!.env.example

# Python, environments, editors, and system files.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.venv/
venv/
env/
.conda/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Training artifacts stay local.
cache/
caches/
.cache/
_shared/
checkpoints/
checkpoint/
weights/
outputs/
outputs_*/
results/
results_*/
